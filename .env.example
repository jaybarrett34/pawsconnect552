# Copy to .env.local (read by both Next.js and FastAPI). Never commit real values.

# Default mode: cached | claude | gemini   (blank = cached)
PROVIDER=

# Gemini live mode: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Claude live mode (local only; uses your `claude` CLI login)
CLAUDE_MODEL=haiku

# Live-mode gate: 2 wrong attempts -> 30 min lockout per IP
LIVE_MODE_PASSCODE=
# openssl rand -base64 32
SESSION_SECRET=

# Cloudflare Turnstile (optional bot check on the unlock form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (auto-injected on Vercel by the Upstash integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=
